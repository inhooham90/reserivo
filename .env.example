# Copy to .env — compose reads this for secrets it interpolates.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string

# Email (optional locally). Get a key at resend.com; verify a sending domain for production.
RESEND_API_KEY=
EMAIL_FROM=Morrri <onboarding@resend.dev>
# Campaign email: a separate Resend key and a separate verified subdomain.
# Unset means campaigns are logged, not sent.
RESEND_MARKETING_API_KEY=
EMAIL_MARKETING_FROM=

# Accounts that always hold site admin, comma-separated. Applied on boot and at registration.
SITE_ADMIN_EMAILS=james@akkija.com

# SMS reminders (optional). US delivery also needs A2P 10DLC registration.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
