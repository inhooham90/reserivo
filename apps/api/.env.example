# Copy to .env for running the api directly on the host (outside compose).
# Inside compose these come from compose.yaml instead.
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://reserivo:reserivo@localhost:5433/reserivo
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
RESEND_API_KEY=
EMAIL_FROM=Morrri <onboarding@resend.dev>
# Campaign email: a separate Resend key and a separate verified subdomain.
# Unset means campaigns are logged, not sent.
RESEND_MARKETING_API_KEY=
EMAIL_MARKETING_FROM=
SITE_ADMIN_EMAILS=james@akkija.com
