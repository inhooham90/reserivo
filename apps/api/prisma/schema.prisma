// Reserivo data model.
// Every tenant-scoped table carries salonId. Roles live on SalonMembership,
// never on User (one person can be a customer at one salon and a designer at
// another). Timestamps are timestamptz (UTC); Salon.timezone is the IANA zone
// used for rendering. Working hours are local wall-clock minutes, resolved
// against Salon.timezone only when a concrete date is involved.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity ----------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?
  name         String
  phone        String?
  isSiteAdmin  Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  memberships   SalonMembership[]
  refreshTokens RefreshToken[]
  invitesSent   Invitation[]
  customerOf    Customer[]
  auditActions  AuditLog[]        @relation("AuditActor")
  auditSubject  AuditLog[]        @relation("AuditImpersonated")

  @@map("users")
}

/// One row per issued refresh token. Rotated on every refresh; revoked on logout.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Tenancy ----------

/// Booking policies live on the salon: slot grid, minimum notice, how far
/// ahead customers may book, and how late they may self-cancel.
model Salon {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  name              String
  timezone          String
  slotIntervalMin   Int      @default(15)
  leadTimeMin       Int      @default(60)
  maxAdvanceDays    Int      @default(60)
  cancelWindowHours Int      @default(24)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  memberships     SalonMembership[]
  invitations     Invitation[]
  services        Service[]
  customers       Customer[]
  appointments    Appointment[]
  hours           SalonHours[]
  hoursExceptions SalonHoursException[]
  conversations   Conversation[]
  auditLogs       AuditLog[]

  @@map("salons")
}

/// The shop's opening hours. Shared by every manager; designers' personal
/// hours must fit inside these, and managers themselves simply work them.
/// Same encoding as AvailabilityRule: weekday 0=Sun…6=Sat, local minutes.
model SalonHours {
  id           String @id @default(uuid()) @db.Uuid
  salonId      String @db.Uuid
  weekday      Int
  startMinutes Int
  endMinutes   Int

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, weekday])
  @@map("salon_hours")
}

/// A closure or special opening for one local date (holiday, early close).
model SalonHoursException {
  id           String        @id @default(uuid()) @db.Uuid
  salonId      String        @db.Uuid
  date         DateTime      @db.Date
  type         ExceptionType
  startMinutes Int?
  endMinutes   Int?
  note         String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, date])
  @@map("salon_hours_exceptions")
}

enum SalonRole {
  MANAGER
  DESIGNER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  REMOVED
}

/// A user's capabilities within one salon. Profile fields live here too.
/// roles is a set: MANAGER administers (team, hours, settings, customer
/// contact info); DESIGNER is bookable (owns services and personal hours,
/// appears on the booking page). A solo operator holds both; a front-desk
/// manager holds only MANAGER; a chair renter only DESIGNER.
model SalonMembership {
  id          String           @id @default(uuid()) @db.Uuid
  salonId     String           @db.Uuid
  userId      String           @db.Uuid
  roles       SalonRole[]
  status      MembershipStatus @default(ACTIVE)
  displayName String
  bio         String?
  photoUrl    String?
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  services               Service[]
  availabilityRules      AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  appointments           Appointment[]
  conversations          Conversation[]

  @@unique([salonId, userId])
  @@index([userId])
  @@map("salon_memberships")
}

/// Manager-issued invite to join a salon. Only the token hash is stored; the
/// raw token appears once in the invite URL. Single use, expires.
model Invitation {
  id              String    @id @default(uuid()) @db.Uuid
  salonId         String      @db.Uuid
  email           String
  roles           SalonRole[]
  tokenHash       String      @unique
  invitedByUserId String?   @db.Uuid
  expiresAt       DateTime  @db.Timestamptz(6)
  acceptedAt      DateTime? @db.Timestamptz(6)
  revokedAt       DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  salon     Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([salonId, email])
  @@map("invitations")
}

// ---------- Catalog ----------

/// A bookable service offered by one member. Price in integer cents.
model Service {
  id          String   @id @default(uuid()) @db.Uuid
  salonId     String   @db.Uuid
  designerId  String   @db.Uuid
  name        String
  category    String?
  description String?
  priceCents  Int
  durationMin Int
  bufferMin   Int      @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  salon        Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  designer     SalonMembership @relation(fields: [designerId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([salonId])
  @@index([designerId, active])
  @@map("services")
}

// ---------- Customers & appointments ----------

/// The salon's record of a client. Belongs to the salon, not the designer.
/// userId links it to an account when the client has one; walk-ins have none.
/// phone/email are the fields the relay exists to protect — never send them
/// to a DESIGNER-role caller.
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  salonId   String   @db.Uuid
  userId    String?  @db.Uuid
  name      String
  email     String?
  phone     String?
  notes     String?
  tags      String[] @default([])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  salon         Salon          @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  conversations Conversation[]

  @@unique([salonId, userId])
  @@index([salonId, email])
  @@index([salonId, phone])
  @@index([salonId, name])
  @@map("customers")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  STAFF
}

/// startAt/endAt bound the service itself; blockEndAt = endAt + bufferMin is
/// the end of the time the designer is actually occupied. It is a stored
/// column (not an expression) because Postgres index expressions must be
/// IMMUTABLE and timestamptz + interval is only STABLE. The migration adds an
/// EXCLUDE constraint on (designerId, tstzrange(startAt, blockEndAt)) for
/// PENDING/CONFIRMED rows — that constraint, not application code, is what
/// prevents double booking. Service name/price/duration are snapshotted
/// because the catalog changes and history must not.
model Appointment {
  id                  String            @id @default(uuid()) @db.Uuid
  salonId             String            @db.Uuid
  designerId          String            @db.Uuid
  customerId          String            @db.Uuid
  serviceId           String?           @db.Uuid
  startAt             DateTime          @db.Timestamptz(6)
  endAt               DateTime          @db.Timestamptz(6)
  blockEndAt          DateTime          @db.Timestamptz(6)
  bufferMin           Int               @default(0)
  status              AppointmentStatus @default(CONFIRMED)
  source              AppointmentSource
  serviceNameSnapshot String
  priceCentsSnapshot  Int
  durationMinSnapshot Int
  notes               String?
  internalNotes       String?
  createdByUserId     String?           @db.Uuid
  cancelledAt         DateTime?         @db.Timestamptz(6)
  cancelledByUserId   String?           @db.Uuid
  cancelReason        String?
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  salon    Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  designer SalonMembership @relation(fields: [designerId], references: [id], onDelete: Restrict)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([designerId, startAt])
  @@index([salonId, startAt])
  @@index([customerId, startAt])
  @@map("appointments")
}

// ---------- Availability ----------

/// Recurring weekly working window. weekday 0=Sun…6=Sat; minutes are local
/// wall-clock minutes from midnight in the salon's timezone.
model AvailabilityRule {
  id           String @id @default(uuid()) @db.Uuid
  salonId      String @db.Uuid
  designerId   String @db.Uuid
  weekday      Int
  startMinutes Int
  endMinutes   Int

  designer SalonMembership @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@index([designerId, weekday])
  @@map("availability_rules")
}

enum ExceptionType {
  OFF
  CUSTOM
}

/// Overrides the weekly rules for one local calendar date: a day off, or a
/// custom window that replaces that day's rules.
model AvailabilityException {
  id           String        @id @default(uuid()) @db.Uuid
  salonId      String        @db.Uuid
  designerId   String        @db.Uuid
  date         DateTime      @db.Date
  type         ExceptionType
  startMinutes Int?
  endMinutes   Int?
  note         String?
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  designer SalonMembership @relation(fields: [designerId], references: [id], onDelete: Cascade)

  @@index([designerId, date])
  @@map("availability_exceptions")
}

// ---------- Messaging relay ----------

/// One thread per customer × designer within a salon. The relay exists so the
/// two sides never need each other's contact details: the customer sees the
/// designer's display name, the designer sees the customer's name. Managers
/// may write in any thread, shown to the customer as the designer.
model Conversation {
  id                 String    @id @default(uuid()) @db.Uuid
  salonId            String    @db.Uuid
  customerId         String    @db.Uuid
  designerId         String    @db.Uuid
  lastMessageAt      DateTime? @db.Timestamptz(6)
  customerLastReadAt DateTime? @db.Timestamptz(6)
  staffLastReadAt    DateTime? @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(6)

  salon    Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  designer SalonMembership @relation(fields: [designerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([customerId, designerId])
  @@index([salonId, lastMessageAt])
  @@index([designerId, lastMessageAt])
  @@map("conversations")
}

enum MessageSender {
  CUSTOMER
  STAFF
}

/// actorUserId is who actually typed; sentAsMembershipId is the identity the
/// customer sees (the thread's designer, even when a manager wrote it).
model Message {
  id                 String        @id @default(uuid()) @db.Uuid
  conversationId     String        @db.Uuid
  sender             MessageSender
  body               String
  actorUserId        String?       @db.Uuid
  sentAsMembershipId String?       @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------- Audit ----------

/// Every mutating request. actorUserId is the real person; impersonatedUserId
/// is set when a site admin is acting as someone else.
model AuditLog {
  id                 String   @id @default(uuid()) @db.Uuid
  actorUserId        String?  @db.Uuid
  impersonatedUserId String?  @db.Uuid
  salonId            String?  @db.Uuid
  action             String
  entityType         String?
  entityId           String?
  before             Json?
  after              Json?
  ip                 String?
  userAgent          String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  actor        User?  @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  impersonated User?  @relation("AuditImpersonated", fields: [impersonatedUserId], references: [id], onDelete: SetNull)
  salon        Salon? @relation(fields: [salonId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([salonId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
